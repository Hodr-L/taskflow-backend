# ============================================
# TaskFlow 鍚庣鐜鍙橀噺閰嶇疆妯℃澘
# 澶嶅埗姝ゆ枃浠朵负 .env 骞朵慨鏀归厤缃€?
# ============================================

# 搴旂敤閰嶇疆
APP_ENV=development                    # development, testing, production
APP_NAME=TaskFlow
APP_VERSION=1.0.0
DEBUG=true                            # 鐢熶骇鐜璁句负 false

# 鏈嶅姟鍣ㄩ厤缃?
SERVER_HOST=0.0.0.0
SERVER_PORT=30088
SERVER_READ_TIMEOUT=10
SERVER_WRITE_TIMEOUT=10
SERVER_IDLE_TIMEOUT=60

# MySQL鏁版嵁搴撻厤缃紙浣跨敤 DB_ 鍓嶇紑锛屼笌 Docker Compose 涓€鑷达級
DB_HOST=localhost                     # 瀹瑰櫒鍐呬娇鐢?mysql
DB_PORT=53306                        # 涓绘満绔彛锛堝鍣ㄥ唴涓?306锛?
DB_NAME=taskflow
DB_USER=taskflow
DB_PASSWORD=taskflow123              # 鈿狅笍 鐢熶骇鐜蹇呴』淇敼
DB_CHARSET=utf8mb4
DB_PARSE_TIME=true
DB_LOC=Local
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=300

# Redis閰嶇疆
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123              # 鈿狅笍 鐢熶骇鐜蹇呴』淇敼
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=2

# JWT閰嶇疆
JWT_SECRET=your-super-secure-jwt-secret-change-in-production  # 鈿狅笍 蹇呴』淇敼锛岄暱搴﹁嚦灏?2浣?
JWT_ACCESS_EXPIRE_HOURS=24           # 璁块棶浠ょ墝鏈夋晥鏈燂紙灏忔椂锛?
JWT_REFRESH_EXPIRE_DAYS=7            # 鍒锋柊浠ょ墝鏈夋晥鏈燂紙澶╋級

# Kafka閰嶇疆锛堝紑鍙戠幆澧冨彲绂佺敤锛?
KAFKA_ENABLED=false                  # 寮€鍙戞椂鍙涓?false
KAFKA_BROKERS=localhost:9092        # 瀹瑰櫒鍐呬娇鐢?kafka:29092
KAFKA_CLIENT_ID=taskflow-backend
KAFKA_NOTIFICATION_GROUP_ID=notification-consumer-group
KAFKA_AUDIT_GROUP_ID=audit-consumer-group

# 鏂囦欢涓婁紶閰嶇疆
UPLOAD_MAX_SIZE=10485760             # 10MB
UPLOAD_STORAGE_PATH=./uploads
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf

# 鏃ュ織閰嶇疆
LOG_LEVEL=info                       # debug, info, warn, error
LOG_FORMAT=json                      # json, text
LOG_OUTPUT=stdout                    # stdout, file

# CORS閰嶇疆
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization,X-Requested-With
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400

# 閭欢閰嶇疆锛堢敤浜庨€氱煡锛屽彲閫夛級
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@taskflow.com
SMTP_TLS=true

# 鐩戞帶閰嶇疆锛堝彲閫夛級
PROMETHEUS_ENABLED=false             # 鐢熶骇鐜鍙惎鐢?
PROMETHEUS_PORT=9090
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PORT=8081

# 閫熺巼闄愬埗锛堝彲閫夛級
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60                 # 绉?

# 鍔熻兘寮€鍏筹紙鍙€夛級
FEATURE_NOTIFICATIONS_ENABLED=true
FEATURE_AUDIT_LOG_ENABLED=true
FEATURE_FILE_UPLOAD_ENABLED=true
FEATURE_REAL_TIME_UPDATES_ENABLED=true

# ============================================
# 浠ヤ笅涓哄吋瀹规€ч厤缃紙鏃у墠缂€锛?
# ============================================
# 鏁版嵁搴撳吋瀹归厤缃紙鏀寔鏃?DATABASE_ 鍓嶇紑锛?
DATABASE_HOST=${DB_HOST}
DATABASE_PORT=${DB_PORT}
DATABASE_NAME=${DB_NAME}
DATABASE_USER=${DB_USER}
DATABASE_PASSWORD=${DB_PASSWORD}
DATABASE_CHARSET=${DB_CHARSET}
DATABASE_PARSE_TIME=${DB_PARSE_TIME}
DATABASE_LOC=${DB_LOC}
DATABASE_MAX_OPEN_CONNS=${DB_MAX_OPEN_CONNS}
DATABASE_MAX_IDLE_CONNS=${DB_MAX_IDLE_CONNS}
DATABASE_CONN_MAX_LIFETIME=${DB_CONN_MAX_LIFETIME}
